# Copy this file to .env and edit only the right-hand side when your layout differs.
# Relative paths are resolved from the ALAM repository root.

# ALAM tokenizer training data.
ALAM_CALVIN_ROOT=data/alam/calvin
ALAM_OXE_VIDEO_ROOT=data/alam/oxe_videos

# Downstream LeRobot training datasets. With this root, repo_id=metaworld_mt50
# resolves to data/lerobot/metaworld_mt50 and repo_id=libero_real resolves to
# data/lerobot/libero_real.
HF_LEROBOT_HOME=data/lerobot

# Local model/data caches.
HF_HOME=.cache/huggingface
OPENPI_DATA_HOME=data/openpi
ALAM_TORCH_HOME=.cache/torch

# Runtime and output directories.
ALAM_ENV_ROOT=.venvs
ALAM_RUNTIME_ROOT=.runtime
ALAM_OUTPUT_ROOT=outputs

# pi0 dependency installation. The portable mode preserves lock versions and
# hashes while fetching from a public index. Set ALAM_PI0_WHEEL_DIR only when
# an offline/local wheel directory is available.
ALAM_PI0_INSTALL_MODE=portable
ALAM_PI0_INDEX_URL=https://pypi.org/simple
ALAM_INSTALL_RETRIES=5
ALAM_SERVER_START_TIMEOUT=1800
# Public MetaWorld release profile. The camera name is fixed to corner2 by the
# preserved evaluator; these values set its absolute world-coordinate position.
ALAM_METAWORLD_CAMERA_X=0.71
ALAM_METAWORLD_CAMERA_Y=0.075
ALAM_METAWORLD_CAMERA_Z=0.70
# LIBERO's preserved robosuite stack uses its visible-device id for EGL.
# Keep 0 unless an EGL render smoke passes with another value on your host.
ALAM_EGL_GPU=0
# ALAM_PI0_WHEEL_DIR=.cache/wheels

# Packaged inference weights.
ALAM_METAWORLD_TOKENIZER=evaluation/checkpoints/alam/metaworld_epoch19_step58216
ALAM_LIBERO_TOKENIZER=evaluation/checkpoints/alam/metaworld_epoch19_step58216
ALAM_METAWORLD_POLICY=evaluation/checkpoints/metaworld/alam_plus_pi_metaworld_mt50_step30000
ALAM_LIBERO_POLICY=evaluation/checkpoints/libero/alam_plus_pi_libero_step30000
